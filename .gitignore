# ==========================================
# .NET Build Artifacts
# ==========================================
bin/
obj/
out/
*.pdb

# ==========================================
# TRLG Runtime Data (auto-generated at first run)
# ==========================================
trlg_app.db
trlg_app.db-journal
trlg_app.db-wal
trlg_app.db-shm
wwwroot/

# ==========================================
# Native SQLite library
# sqlite3.dll (Windows) IS committed to this repo for convenience -- see README.md.
# Other-platform builds (.so / .dylib) are still excluded since this repo
# targets Windows; add and un-ignore them here if you need Linux/macOS binaries too.
# ==========================================
sqlite3.so
libsqlite3.dylib

# ==========================================
# IDE / Editor
# ==========================================
.vs/
.vscode/
*.user
*.suo
.idea/
*.DotSettings.user

# ==========================================
# OS files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# NuGet (not used here, but future-proof)
# ==========================================
*.nupkg
packages/
